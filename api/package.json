{
  "name": "lanche-facil-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST local (json-server) usada pelo app Lanche Fácil nas aulas de HTTP e Persistência.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "resetar": "node server.js --resetar",
